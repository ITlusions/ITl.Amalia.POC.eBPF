{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sensor workflow",
  "type": "object",
  "required": ["id", "name", "version", "scope", "steps"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "scope": {
      "type": "object",
      "required": ["authorization", "environment"],
      "properties": {
        "authorization": { "type": "string" },
        "environment": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "outputs", "mappings"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "status": { "enum": ["implemented", "partial", "planned", "external"] },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "standards": { "type": "array", "items": { "type": "string" } },
          "mappings": {
            "type": "object",
            "properties": {
              "tools": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
              "features": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
              "controls": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
            }
          },
          "gaps": { "type": "array", "items": { "type": "string" } },
          "next": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "status": { "enum": ["implemented", "partial", "planned", "external"] }
      }
    }
  }
}
